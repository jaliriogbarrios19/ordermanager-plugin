{
  "name": "ordermanager",
  "version": "1.1.1",
  "description": "Gestión contable para emprendimientos: clientes, proveedores, inventario, transacciones y deudas",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "accounting",
    "inventory",
    "finance"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "obsidian": "latest",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  }
}
